{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],

    "module": "CommonJS",
    "moduleResolution": "Node",

    "jsx": "react-jsx",

    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "resolveJsonModule": true,
    "isolatedModules": true,

    "noEmit": true,

    "forceConsistentCasingInFileNames": true
  },

  "include": ["src"]
}